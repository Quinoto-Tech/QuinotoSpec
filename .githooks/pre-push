#!/bin/bash

# Pre-push hook: Runs full test suite before pushing

set -e

# Resolve real script location (hook is symlinked from .git/hooks/)
SCRIPT_FILE="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || dirname "$(dirname "$SCRIPT_FILE")")"

echo "Running pre-push checks..."
echo ""

# Run test suite
if ! bash "$PROJECT_ROOT/tests/run-all-tests.sh"; then
    echo ""
    echo "Pre-push check failed: tests failing"
    echo "Fix the errors or use --no-verify to skip"
    exit 1
fi

echo ""
echo "Pre-push checks passed"
exit 0
